# Deployment environment for the compose prod overlay.
#   cp .env.example .env.prod
# Copy to .env.prod, NOT to .env — the root .env holds unrelated local secrets.
# Application config for tests lives separately in backend/.env.example.

# --- Read by compose (interpolation) — no equivalent in local development ---

# Caddy site address. localhost uses Caddy's internal CA; a real hostname
# triggers Let's Encrypt. ACME_EMAIL is unused for localhost but must be set,
# because an empty Caddy placeholder is a config parse error.
DOMAIN=localhost
ACME_EMAIL=dev@example.com

# API image tag. RRG-21 sets this to the commit SHA.
TAG=latest

# --- Read by the application (pydantic-settings) — same keys as backend/.env.example ---

ENVIRONMENT=prod

# DB_HOST is the compose service name. DB_PASS must be generated for a real
# deploy; it also seeds POSTGRES_PASSWORD on the db container.
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=regrag

# The origin serving the frontend. RRG-21 sets this to the Cloudflare Pages domain.
CORS_ORIGINS=["http://localhost:5173"]

# Required: PROJECT_ROOT resolves to / inside the image, so leaving this unset
# silently defaults the corpus to /data/raw rather than the repo's data/raw.
RAW_DATA_DIR=/data/raw
