# Deployment environment for the compose prod overlay: `cp .env.example .env.prod`.
# Not .env — that holds unrelated local secrets. App config for tests is in backend/.env.example.

# --- Read by compose (interpolation) ---

# localhost uses Caddy's internal CA; a real hostname triggers Let's Encrypt.
# ACME_EMAIL is unused for localhost but must be non-empty to parse.
DOMAIN=localhost
ACME_EMAIL=dev@example.com

# API image tag. RRG-21 sets this to the commit SHA.
TAG=latest

# --- Read by the application (pydantic-settings) ---

ENVIRONMENT=prod

# DB_HOST is the compose service name. DB_PASS also seeds POSTGRES_PASSWORD on
# the db container, and must be generated for a real deploy.
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=regrag

# The origin serving the frontend. RRG-21 sets this to the Cloudflare Pages domain.
CORS_ORIGINS=["http://localhost:5173"]

# Matches the raw-data volume mount. Also the in-image default, set explicitly
# so the corpus location survives a change to PROJECT_ROOT.
RAW_DATA_DIR=/data/raw
