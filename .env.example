# Copy to .env.prod for the compose prod overlay

# Caddy site address and ACME contact
DOMAIN=localhost
ACME_EMAIL=dev@example.com

# API image tag
TAG=latest

# Environment: dev, test, prod
ENVIRONMENT=prod

# External prefix Caddy strips before proxying
ROOT_PATH=/api

# PostgreSQL Database (also seeds the db container)
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=regrag

# CORS origins as a JSON list
CORS_ORIGINS=["http://localhost:5173"]

# Where the ingest CLI writes fetched documents
RAW_DATA_DIR=/data/raw
