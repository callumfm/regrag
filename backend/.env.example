# Environment: dev, test, prod
ENVIRONMENT=test

# PostgreSQL Database (compose db service)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=regrag

# CORS origins as a JSON list (Vite dev origin)
CORS_ORIGINS=["http://localhost:5173"]

# Where the ingest CLI writes fetched documents (defaults to <repo>/data/raw)
# RAW_DATA_DIR=/var/lib/regrag/raw

# Voyage embeddings (real key goes in .env.dev; empty here — .env.example is the test env file)
VOYAGE_API_KEY=
