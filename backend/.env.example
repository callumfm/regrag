# Environment: dev, test, prod
ENVIRONMENT=test

# PostgreSQL Database (compose db service). This is the dev template — copied to .env.dev — and
# doubles as the test env file, so tests override DB_NAME in tests/__init__.py rather than here.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=regrag

# CORS origins as a JSON list (Vite dev origin)
CORS_ORIGINS=["http://localhost:5173"]

# Raw document storage: local (filesystem, dev and tests) or r2 (Cloudflare R2, prod)
STORAGE_BACKEND=local

# Root of the local store, used when STORAGE_BACKEND=local (defaults to <repo>/data/raw)
# RAW_DATA_DIR=/var/lib/regrag/raw

# Cloudflare R2, required when STORAGE_BACKEND=r2 (real values go in .env.prod)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Voyage embeddings (real key goes in .env.dev; empty here — .env.example is the test env file)
VOYAGE_API_KEY=

# Anthropic API key for chat (real key goes in .env.dev; empty here — .env.example is the test env file)
ANTHROPIC_API_KEY=

# Off switches for the cross-encoder rerank of fused search results, for widening a hit
# to its whole section, and for the assess loop that grows the context before the answer
RERANK_ENABLED=true
EXPAND_SECTIONS=false
ASSESS_ENABLED=true

# Other search tunables, defaults in RetrievalConfig (SEARCH_CANDIDATES, SEARCH_DEFAULT_LIMIT,
# RRF_K, RERANK_MODEL, RERANK_TIMEOUT, RERANK_POOL); chat tunables in ChatConfig (CHAT_MODEL,
# CHAT_TIMEOUT, CHAT_MAX_TOKENS, CHAT_TEMPERATURE, CHAT_SOURCES, CHAT_CONTEXT_CHUNKS); loop
# tunables in AssessConfig (ASSESS_MODEL, ASSESS_MAX_ROUNDS, ASSESS_MAX_CALLS, ASSESS_SEARCH_LIMIT,
# ASSESS_EXTRA_CHUNKS)
