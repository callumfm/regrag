{
	"$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
	"files": {
		"includes": [
			"**",
			"!src/routeTree.gen.ts",
			"!src/api/schema.ts",
			"!openapi.json",
			"!public",
			"!dist"
		]
	},
	"formatter": { "indentStyle": "tab" },
	"javascript": {
		"formatter": { "quoteStyle": "single", "semicolons": "asNeeded" }
	},
	"css": {
		"parser": { "tailwindDirectives": true }
	},
	"linter": { "enabled": true }
}
